# Supabase Configuration
# IMPORTANT: Production values should be set in Vercel environment variables.
# This file is kept for local development only. Do NOT commit real keys.
VITE_SUPABASE_PROJECT_ID="eutszmrsukoqqeilzrbv"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://eutszmrsukoqqeilzrbv.supabase.co"

# Meta Pixel — client-side event tracking for Meta/WhatsApp ads (see src/lib/analytics.ts).
# Unset = pixel never loads, trackEvent() stays Supabase-only. Set once
# Business Manager access is granted and a Pixel is created; no code change needed.
VITE_META_PIXEL_ID=

# Meta Conversions API — server-side event relay (see api/_shared/metaCapi.ts).
# SERVER-ONLY: never prefix with VITE_, that would bake it into the public JS
# bundle and leak a live token that can post events on our ad account.
# Generate in Events Manager -> Pixel -> Settings -> Conversions API.
# Set on Vercel (this endpoint + eft-create-order) AND as a Supabase secret
# (`supabase secrets set`) for eft-reconcile, which is the only place
# Purchase is ever emitted from (see supabase/functions/_shared/metaCapi.ts).
META_CAPI_ACCESS_TOKEN=
# Same Pixel ID as VITE_META_PIXEL_ID above, but supabase/functions (Deno) can't
# read Vite env vars — set this as a Supabase secret for eft-reconcile only.
META_PIXEL_ID=
# Optional: set while verifying in Events Manager's Test Events tab so test
# traffic doesn't pollute real ad optimization data. Unset in production.
META_CAPI_TEST_EVENT_CODE=
